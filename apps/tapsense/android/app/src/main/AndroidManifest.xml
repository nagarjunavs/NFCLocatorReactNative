<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Haptic confirmation on a detected tap (Settings > Haptic feedback). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- android.permission.NFC and the optional nfc uses-feature come from the library's own manifest. -->
    <!-- INTERNET is debug-only (Metro); the release app makes no network calls (see src/debug). -->

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:localeConfig="@xml/locales_config"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="${usesCleartextTraffic}"
      android:supportsRtl="true"
      tools:targetApi="33">
      <!--
        Portrait-only: the antenna-marker illustrations are hand-tuned against a
        portrait silhouette, and this is a phone-only NFC utility, not a large-screen target.
      -->
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|locale|layoutDirection"
        android:launchMode="singleTask"
        android:screenOrientation="portrait"
        android:windowSoftInputMode="adjustResize"
        android:exported="true"
        tools:ignore="LockedOrientationActivity,DiscouragedApi">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity>
    </application>
</manifest>
